{
  "title": "Sweep",
  "description": "Karaoke: one line of tall condensed capitals, all up from the start; the highlight colour fills each word from left to right exactly while it is spoken and stays, with a bump when a word is full. The line grows out of its baseline, drains and drops to leave.",
  "font": { "family": "Bebas Neue", "file": "captions/BebasNeue-Regular.ttf", "weight": 400, "style": "normal" },
  "emphFont": null,
  "size": 122,
  "minSize": 64,
  "lineHeight": 1.05,
  "letterSpacing": 0.012,
  "wordGap": 0.3,
  "case": "upper",
  "emphScale": 1,
  "grow": 0.04,
  "tilt": 0,
  "margin": { "x": 36, "y": 30 },
  "paging": {
    "mode": "page",
    "maxWords": 5,
    "maxLines": 1,
    "gapS": 0.6,
    "holdS": 0.5,
    "lingerS": 0.3,
    "minShowS": 0.14,
    "leadS": 0.03,
    "overlapS": 0
  },
  "timing": { "enterS": 0.3, "exitS": 0.3, "activeInS": 0.1, "activeOutS": 0.16, "colorS": 0.25, "staggerS": 0.03 },
  "colors": {
    "text": "#FFFFFF",
    "active": "#00E5FF",
    "emph": "#FF70CB",
    "stroke": "#0B0B12",
    "shadow": "#000000",
    "plate": "#0B0B12",
    "plateText": "#FFFFFF",
    "accent": "#00E5FF",
    "accent2": "#FF70CB",
    "cycle": ["#00E5FF"]
  },
  "auto": {
    "candidates": {
      "text": ["white"],
      "active": ["cyan", "lime", "yellow", "mint", "orange"],
      "emph": ["pink", "orange", "gold", "violet", "yellow"],
      "stroke": ["ink"]
    },
    "pairs": [
      ["text", "stroke"],
      ["active", "stroke"],
      ["emph", "stroke"],
      ["plateText", "stroke"]
    ],
    "avoidHue": ["active", "emph"],
    "distinct": [["active", "emph"]]
  },
  "label": { "size": 120, "enterS": 0.25, "exitS": 0.16, "rotate": 0 },
  "fx": {
    "halo": 0.085,
    "shadowY": 0.07,
    "riseFreq": 4.2,
    "riseDamp": 0.55,
    "riseY": 0.06,
    "lean": 14,
    "tintS": 0.09,
    "fillSwell": 0.045,
    "fillLift": 0.02,
    "bump": 0.09,
    "bumpS": 0.28,
    "emphBump": 1.5,
    "drainShare": 0.7,
    "dropFrom": 0.3,
    "dropY": 0.2,
    "labelFillS": 0.45
  }
}

      "text": ["cream"],
      "active": ["white"],
      "emph": ["yellow", "lime", "cyan", "mint"],
      "stroke": ["black"],
      "shadow": ["black"],
      "accent": ["red", "pink", "orange", "violet"]
    },
    "pairs": [
      ["text", "stroke"],
      ["active", "stroke"],
      ["emph", "stroke"],
      ["accent", "stroke"],
      ["accent", "shadow"]
    ],
    "avoidHue": ["emph", "accent"],
    "distinct": [["emph", "accent"]]

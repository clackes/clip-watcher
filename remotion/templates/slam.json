{
  "title": "Slam",
  "description": "One word at a time, as big as the box allows: every word comes down from far too big, hits, flattens, shakes and throws out a deep extrusion; shouted words are bigger, yellow and shake longer; before a pause the word tips over and drops out.",
  "font": { "family": "Anton", "file": "Anton-Regular.ttf", "weight": 400, "style": "normal" },
  "emphFont": null,
  "size": 146,
  "minSize": 60,

  "letterSpacing": 0.01,
  "wordGap": 0.24,
  "case": "upper",
  "emphScale": 1.26,
  "grow": 0,
  "tilt": 3.5,
  "margin": { "x": 24, "y": 18 },
  "paging": {
    "mode": "page",
    "maxWords": 1,
    "maxLines": 1,
    "gapS": 0.6,
    "holdS": 0.45,
    "lingerS": 0.2,
    "minShowS": 0.14,
    "leadS": 0.03,
    "overlapS": 0.06
  },
  "timing": { "enterS": 0.12, "exitS": 0.2, "activeInS": 0.08, "activeOutS": 0.25, "colorS": 0.16, "staggerS": 0 },
  "colors": {
    "text": "#FFF3D6",
    "active": "#FFFFFF",
    "emph": "#FFE600",
    "stroke": "#000000",
    "shadow": "#000000",
    "plate": "#000000",
    "plateText": "#FFFFFF",
    "accent": "#FF6B5E",
    "accent2": "#00E5FF",
    "cycle": ["#FFE600"]
  },
  "auto": {

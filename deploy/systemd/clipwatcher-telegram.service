[Unit]
Description=Clip Watcher Telegram approval bot (buttons, uploads on Approve, missing cards)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=clipbot
WorkingDirectory=/opt/clip-watcher
EnvironmentFile=/etc/clipwatcher/env
EnvironmentFile=/etc/clipwatcher/secrets.env
ExecStart=/opt/clip-watcher/.venv/bin/python -m clipwatcher.queue.telegram_bot
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target

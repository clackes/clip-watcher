[Unit]
Description=Clip Watcher live lane (record, chat, detect, clip, stage, Telegram cards)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=clipbot
WorkingDirectory=/opt/clip-watcher
EnvironmentFile=/etc/clipwatcher/env
EnvironmentFile=/etc/clipwatcher/secrets.env
ExecStart=/opt/clip-watcher/.venv/bin/python -m clipwatcher.live
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target

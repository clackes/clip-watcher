[Unit]
Description=Clip Watcher render/judge worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
NotifyAccess=main
User=clipbot
WorkingDirectory=/opt/clip-watcher
EnvironmentFile=/etc/clipwatcher/env
LoadCredential=secrets.env:/etc/clipwatcher/secrets.env
Environment=CLIPWATCHER_CREDENTIALS_FILE=%d/secrets.env
ExecStart=/opt/clip-watcher/.venv/bin/python -m clipwatcher.queue.worker
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target

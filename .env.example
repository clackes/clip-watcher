# Copy to .env (gitignored). Everything is optional: with nothing set, the live lane records, detects,
# captions and stages clips in staging/ without logging in anywhere.
DRY_RUN=1
TELEGRAM_BOT_TOKEN=          # from @BotFather; enables approval cards in the team chat
ANTHROPIC_API_KEY=           # enables the Claude screen/judge (hooks, titles); heuristic fallback without it
# CLIPWATCHER_DATA=/data/work         # recordings, chat logs (NAS volume)
# CLIPWATCHER_STAGING=/data/staging   # clip packages + clips.db
# YouTube: token from scripts/youtube_auth.py (gitignored secrets/)
YOUTUBE_CREDENTIALS=secrets/youtube_token.json

# Copy to .env (gitignored). Everything is optional: with nothing set, the live lane records, detects,
# captions and stages clips in staging/ without logging in anywhere.
# One KEY=value per line, comments on their own lines: not every loader of this file (systemd, older
# scripts) cuts a "# comment" off the end of a value.
DRY_RUN=1
# From @BotFather; enables approval cards in the team chat.
TELEGRAM_BOT_TOKEN=
# Enables the Claude screen/judge (hooks, titles); heuristic fallback without it.
ANTHROPIC_API_KEY=
# Recordings and chat logs (NAS volume).
# CLIPWATCHER_DATA=/data/work
# Clip packages + clips.db. The live lane, the approval bot and the publisher must all see the same value.
# CLIPWATCHER_STAGING=/data/staging
# YouTube: token from scripts/youtube_auth.py (gitignored secrets/)
YOUTUBE_CREDENTIALS=secrets/youtube_token.json
